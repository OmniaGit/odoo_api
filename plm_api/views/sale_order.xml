<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="plm_api_view_order_form" model="ir.ui.view">
            <field name="name">plm.api.view/order.form"</field>
	        <field name="model">sale.order</field>
	        <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
	            <xpath expr="//field[@name='order_line']//form//field[@name='product_uom_qty']" position="before">
	                <field name="is_api_configurator" invisble="True"/>
	                <field name="api_configurator_value"/>
	                <field name="api_node_engine_name" invisble="True"/>
	            </xpath>
            </field>
        </record>
    </data>
</odoo>


